NODE_ENV=development
PORT=3000
ALLOWED_HOSTS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://postgres:password@localhost:5432/app?schema=public

# Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_SECRET_REFRESH=replace-with-a-different-long-random-secret

# Optional integrations already represented in package.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
