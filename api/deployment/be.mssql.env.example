NODE_ENV=production
PORT=3000
ALLOWED_HOSTS=https://app.example.com
DB_PROVIDER=mssql
DB_HOST=sqlserver.example.com
DB_PORT=1433
DB_INSTANCE=
DB_USER=app_user
DB_PASSWORD=change-me
DB_NAME=app
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET_REFRESH=replace-with-a-different-long-random-secret
