NODE_ENV=development
PORT=3000
ALLOWED_HOSTS=http://localhost:5173,http://127.0.0.1:5173

# Required: postgresql or mssql
DB_PROVIDER=postgresql

# PostgreSQL connection. Used only when DB_PROVIDER=postgresql.
DATABASE_URL=postgresql://postgres:password@localhost:5432/app?schema=public

# SQL Server connection. Used only when DB_PROVIDER=mssql. These defaults are
# compatible with common SQL Server 2008 installations. Prefer DB_HOST+DB_PORT;
# set DB_INSTANCE only when connecting to a named instance.
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=
DB_USER=sa
DB_PASSWORD=password
DB_NAME=app
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_SECRET_REFRESH=replace-with-a-different-long-random-secret

# Optional integrations already represented in package.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
