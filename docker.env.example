# A unique value prevents names and volumes from colliding with other stacks.
COMPOSE_PROJECT_NAME=my-app-local
APP_ENVIRONMENT=local
API_HOST_PORT=3000
WEB_HOST_PORT=8080
BACKEND_ENV_FILE=./api/.env

# Used only with: docker compose --profile postgres ...
POSTGRES_HOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
